<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ims.mapper.SiteConfigMapper">

    <select id="findAll" resultType="com.ims.entity.SiteConfig">
        SELECT `key`, `value` FROM site_config
    </select>

    <select id="findByKey" resultType="com.ims.entity.SiteConfig">
        SELECT `key`, `value` FROM site_config WHERE `key` = #{key}
    </select>

    <insert id="insert">
        INSERT INTO site_config (`key`, `value`) VALUES (#{key}, #{value})
    </insert>

    <update id="update">
        UPDATE site_config SET `value` = #{value} WHERE `key` = #{key}
    </update>

</mapper>
